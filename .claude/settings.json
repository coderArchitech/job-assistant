{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/after_edit.sh",
            "timeout": 30,
            "statusMessage": "Checking safety rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre_push.sh",
            "timeout": 1200,
            "statusMessage": "Running pre-push checks"
          }
        ]
      }
    ]
  }
}
